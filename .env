# Python path for MCP server imports
PYTHONPATH=/workspace/mcp_servers/ToolUniverse2/src:/workspace/mcp_servers/paper-qa2/src:/workspace/mcp_servers/local-deep-research2/src:/workspace/mcp_servers/open-coscientist-v2/src:/workspace/aura_temp

# AURA LLM Configuration
AURA_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-a9954d599b4f4cb185c80f138d3af077
LLM_MODEL=deepseek-v4-flash

# DeepSeek API base URL
DEEPSEEK_API_KEY=sk-a9954d599b4f4cb185c80f138d3af077
DEEPSEEK_API_BASE=https://api.deepseek.com

# MCP Outbound Gateway — ENABLE
AURA_MCP_OUTBOUND_ENABLED=1
AURA_MCP_TIMEOUT_SECONDS=300
AURA_MCP_RESEARCH_TIMEOUT_SECONDS=3600
AURA_MCP_APPROVAL_ASSUME_YES=1
AURA_MCP_REQUIRE_APPROVAL=0

# Per-server enable flags
AURA_MCP_USE_LOCAL_DEEP_RESEARCH=1
AURA_MCP_USE_IDEA_REALITY=1
AURA_MCP_USE_TOOLUNIVERSE=1
AURA_MCP_USE_OPEN_COSCIENTIST=1
AURA_MCP_USE_JUPYTER=1
AURA_MCP_USE_PAPER_QA=1

# Skip Ollama (using remote DeepSeek)
AURA_SKIP_OLLAMA_BOOTSTRAP=1

# MCP launch commands (all use python -m for reliability)
AURA_LDR_MCP_COMMAND=python
AURA_LDR_MCP_ARGS=-m local_deep_research.mcp

AURA_IDEA_REALITY_MCP_COMMAND=python
AURA_IDEA_REALITY_MCP_ARGS=-m idea_reality_mcp

AURA_TOOLUNIVERSE_MCP_COMMAND=python
AURA_TOOLUNIVERSE_MCP_ARGS=-m tooluniverse.smcp_server

AURA_OPEN_COSCIENTIST_MCP_COMMAND=python
AURA_OPEN_COSCIENTIST_MCP_ARGS=/workspace/aura_temp/mcp_wrappers/open_coscientist/coscientist_server.py

AURA_JUPYTER_MCP_COMMAND=python
AURA_JUPYTER_MCP_ARGS=-m jupyter_mcp_server

AURA_PAPER_QA_MCP_COMMAND=python
AURA_PAPER_QA_MCP_ARGS=-m paperqa.mcp_server
