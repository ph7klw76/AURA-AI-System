AURA_MODEL=qwen3:8b
AURA_TEMPERATURE=0.2
AURA_NUM_CTX=8192
AURA_KEEP_ALIVE=30m
OPENALEX_API_KEY=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# ---------------------------------------------------------------------------
# SearXNG — recommended self-hosted, free web-search provider
# ---------------------------------------------------------------------------
# Set SEARXNG_ENABLED=1 to use SearXNG as the primary search provider for
# Deep Research. Requires a running SearXNG instance with JSON output enabled.
# See deployment/searxng/ for a ready-to-use Docker Compose setup.
#
# SearXNG is the recommended provider for reproducibility, but it is NOT the
# only web-search backend in this repository: the provider-neutral patent
# subsystem also ships no-key web providers (google_web_no_key,
# duckduckgo_html) and a mock provider — see "Patent search PROVIDER
# subsystem" below.  Tavily and other commercial paid search APIs are
# intentionally NOT supported.
#
# One-time setup (Windows):
#   python scripts/setup_searxng_windows.py
# Then start the stack:
#   docker compose -f deployment/searxng/docker-compose.yml up -d
#
# JSON output MUST be enabled in settings.yml → formats: [html, json]
# If you see HTTP 403 for format=json, this is the most likely cause.
# ---------------------------------------------------------------------------
SEARXNG_ENABLED=0
SEARXNG_URL=http://localhost:8080
SEARXNG_TIMEOUT_SECONDS=20
SEARXNG_CONTAINER_NAME=searxng
# Auto-start the container when Deep Research is invoked (0 to disable)
SEARXNG_AUTO_START=1
# Windows only: launch Docker Desktop if daemon is not running (0 to disable)
SEARXNG_AUTO_START_DOCKER_DESKTOP=1
# Override with path to your compose file if not using deployment/searxng/
SEARXNG_DOCKER_COMPOSE_FILE=
# Override with the directory containing your docker-compose.yml
SEARXNG_DOCKER_PROJECT_DIR=
# Query used for the JSON API health check (any innocuous search term)
SEARXNG_JSON_HEALTH_QUERY=searxng

# ---------------------------------------------------------------------------
# Deep Research — rigorous structured-report enhancement layer
# ---------------------------------------------------------------------------
# The deep_research subsystem runs an ADDITIVE rigor pass: purpose
# clarification, scope card, question decomposition, per-source 7-axis
# quality scoring, seven core analyses, competing-interpretation synthesis,
# and a 7-gate final check.  There is EXACTLY ONE report file per mission,
# the 16-section rigorous report, saved as
#     reports/deep_research/<mission_id>_report.md
# (there is no separate ``_rigorous_report.md`` companion — see CLAUDE.md).
#
# This layer NEVER modifies the verifier or the evidence/memory persistence
# paths.
#
# THE 16-SECTION RIGOROUS REPORT IS MANDATORY (see CLAUDE.md).  This
# variable is NOT an opt-out — it is a degraded-mode toggle for hermetic
# offline tests that have no LLM available.  When =0, the markdown file
# is STILL written with structural placeholders so the 16-section
# contract holds.  Production runs must leave this at 1.
AURA_DEEP_RESEARCH_RIGOR=1

# ---------------------------------------------------------------------------
# Patent Web Search (Stage 1) — preliminary web-based patent reconnaissance
# ---------------------------------------------------------------------------
# Stage 1 = provider-neutral web discovery of publicly indexed patent landing
# pages on patents.google.com, patentscope.wipo.int, and uspto.gov.  The
# backend is selected by the provider subsystem below (SearXNG, a no-key web
# provider, or mock).  It is NOT a substitute for formal prior-art search,
# freedom-to-operate analysis, or patent counsel.
# ---------------------------------------------------------------------------
PATENT_WEB_SEARCH_ENABLED=1
# "auto" = use whichever real provider is configured (see the provider
# subsystem below: SearXNG if enabled, else a no-key web provider).
PATENT_WEB_SEARCH_PROVIDER=auto
PATENT_WEB_QUERY_COUNT=4
PATENT_WEB_MAX_RESULTS_PER_QUERY=10
PATENT_WEB_MAX_PAGES_TO_FETCH=20
PATENT_WEB_FETCH_TIMEOUT_SECONDS=20
PATENT_WEB_MAX_RESPONSE_BYTES=2000000
PATENT_WEB_ALLOWED_DOMAINS=patents.google.com,patentscope.wipo.int,uspto.gov
# LEGACY mock-fallback flag (Stage-1 patent web search).
# DEFAULT 0 — synthetic patent results are opt-in only.  This legacy
# var is consulted ONLY when the canonical
# AURA_PATENT_SEARCH_ALLOW_MOCK_FALLBACK is UNSET; if the canonical var
# is set (even to 0) it wins.  Do NOT set this to 1 unless you
# explicitly want synthetic fallback in BOTH search subsystems.
PATENT_WEB_ALLOW_MOCK_FALLBACK=0

# ---------------------------------------------------------------------------
# Patent search PROVIDER subsystem (provider-neutral abstraction)
# ---------------------------------------------------------------------------
# The Patent Intelligence Agent talks to a provider abstraction rather than
# a hardwired backend, so retrieval can be swapped without rewriting the
# research workflow.  Supported values for AURA_PATENT_SEARCH_PROVIDER:
#   google_web_no_key — best-effort Google SERP scrape (no API key needed).
#                       Honest, conservative: detects CAPTCHA/consent/block
#                       pages and falls back.  NOT the Google Custom Search
#                       API.  Non-exhaustive.  Prone to retrieval variability.
#   searxng           — self-hosted SearXNG meta-search (recommended for
#                       reproducibility; requires the SearXNG stack above).
#   mock              — synthetic results, for hermetic tests / explicit
#                       offline runs.  Never silently selected.
#   auto              — choose SearXNG if SEARXNG_ENABLED=1, else
#                       google_web_no_key.
AURA_PATENT_SEARCH_PROVIDER=auto

# When the primary provider fails (e.g. Google blocked, SearXNG down) the
# factory may fall back to an alternate.  Set to 0 to fail closed instead.
AURA_PATENT_SEARCH_ALLOW_FALLBACK=1

# Comma-separated fallback chain (in order). Excludes the primary.
# "mock" only takes effect if AURA_PATENT_SEARCH_ALLOW_MOCK_FALLBACK=1.
AURA_PATENT_SEARCH_FALLBACK_CHAIN=searxng

# Mock fallback is opt-in. Default OFF — drafts will never silently contain
# synthetic patent data.
AURA_PATENT_SEARCH_ALLOW_MOCK_FALLBACK=0

# Conservative cap on result count per query.
AURA_PATENT_SEARCH_MAX_RESULTS=10

# Master kill-switch for the Google no-key provider (set to 0 to disable
# entirely; the factory will demote to the next fallback provider).
AURA_GOOGLE_WEB_PATENT_ENABLED=1

# ---------------------------------------------------------------------------
# Model Context Protocol (MCP) — outbound client gateway
# ---------------------------------------------------------------------------
# AURA can OPTIONALLY call selected, allowlisted external MCP servers (e.g.
# Local Deep Research, idea-reality) as SUPPLEMENTARY, UNVERIFIED evidence
# providers.  External MCP output is NEVER an authority: it is normalized,
# confidence-capped (never above "medium" pre-verification), audited, and
# passed through AURA's Scientific Verifier before influencing any draft.
#
# Everything is OFF by default except AURA_MCP_REQUIRE_VERIFIER.
#
# Master switch for the outbound gateway (must be 1 for any external call):
AURA_MCP_OUTBOUND_ENABLED=0
# External MCP evidence MUST pass AURA's Scientific Verifier before final use.
# Leave at 1 (default).  Setting 0 is NOT recommended.
AURA_MCP_REQUIRE_VERIFIER=1
# Human-in-the-loop approval: when an AGENT triggers an external MCP call AURA
# prompts the operator (y/N) first.  Default ON; with no interactive terminal
# the call is DENIED (fail-safe).  Set ASSUME_YES=1 only for unattended runs.
AURA_MCP_REQUIRE_APPROVAL=1
AURA_MCP_APPROVAL_ASSUME_YES=0
# Network MCP servers + mock external output remain disabled unless set:
AURA_MCP_ALLOW_NETWORK_SERVERS=0
AURA_MCP_ALLOW_MOCK=0
# Timeouts + audit log:
AURA_MCP_TIMEOUT_SECONDS=60
AURA_MCP_RESEARCH_TIMEOUT_SECONDS=1800
AURA_MCP_AUDIT_LOG=data/mcp_calls.jsonl

# --- Per-server enable flags (all OFF by default) -------------------------
# Each external server is OFF until explicitly enabled AND given a launch
# command (or an installed binary on PATH).  Outbound master switch above
# must also be 1.
AURA_MCP_USE_LOCAL_DEEP_RESEARCH=0
AURA_MCP_USE_IDEA_REALITY=0
AURA_MCP_USE_GITHUB=0

# Env-configurable launch commands (avoid hardcoding fragile commands).
# Example: AURA_LDR_MCP_COMMAND=uvx   AURA_LDR_MCP_ARGS=local-deep-research-mcp
AURA_LDR_MCP_COMMAND=
AURA_LDR_MCP_ARGS=
AURA_IDEA_REALITY_MCP_COMMAND=
AURA_IDEA_REALITY_MCP_ARGS=
# Example: AURA_GITHUB_MCP_COMMAND=docker
#          AURA_GITHUB_MCP_ARGS=run -i --rm ghcr.io/github/github-mcp-server
AURA_GITHUB_MCP_COMMAND=
AURA_GITHUB_MCP_ARGS=
# GitHub auth is read from the environment ONLY and never logged.
# Set ONE of these to your read-only PAT when AURA_MCP_USE_GITHUB=1:
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_TOKEN=

# --- Legacy per-workflow opt-ins (still honoured for back-compat) ---------
# These remain accepted alongside the per-server flags above.
AURA_MCP_USE_IN_RESEARCH_SCOUT=0
AURA_MCP_USE_IN_FOUNDER=0
AURA_MCP_USE_IN_PATENT=0
